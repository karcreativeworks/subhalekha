# Used to sign session cookies — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Optional env override for admin login (otherwise use `npm run seed:admin`)
# ADMIN_CLIENT_ID=your-client-id
# ADMIN_CLIENT_KEY=your-secret-key

# Optional overrides for seed:admin
# SEED_ADMIN_CLIENT_ID=subhakar
# SEED_ADMIN_CLIENT_KEY=your-secret-key

# DigitalOcean Spaces (public read URLs — use your Cloudflare-proxied custom CDN domain)
# SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# SPACES_BUCKET=your-bucket
# SPACES_CDN_ENDPOINT=https://media.subhalekha.live

# Cloudflare Image Resizing (same host as SPACES_CDN_ENDPOINT when possible)
# CLOUDFLARE_IMAGE_ZONE=media.subhalekha.live

# Public guest site — tenant for /[eventSlug] pages (defaults to subhakar)
PUBLIC_CLIENT_ID=subhakar

# Canonical site URL for Open Graph / metadata (production: https://yoursite.com)
# NEXT_PUBLIC_SITE_URL=https://subhalekha.live
